Fraud Loss Statement = 
VAR CurrMonth = MAX('Date'[Month Name])
VAR CurrAmt = [Fraud Loss]
VAR PrevMonth = 
    CALCULATE(
        MAX('Date'[Month Name]),
        DATEADD('Date'[Date], -1, MONTH)
    )
VAR PrevAmt = [Fraud Loss PM]
VAR ChangePct = [Fraud Loss MoM %]
VAR Direction = IF(ChangePct < 0, "Decrease", "Increase")
RETURN
"Fraud losses for the period of " & CurrMonth & ": SAR " & 
FORMAT(CurrAmt, "#,##0") & " compared to the previous month " & 
PrevMonth & ": SAR " & FORMAT(PrevAmt, "#,##0") & " | " & 
Direction & " of " & FORMAT(ABS(ChangePct), "0.0%")
