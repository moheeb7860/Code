WITH firstrestriction AS (
    SELECT 
        e.sabbaccountnumber, 
        e.id_number,
        MIN(e.dateandtimestampofinitiation) AS first_rest_time 
    FROM dp_vew_sem_risk_fraud.efm e
    WHERE e.transaction_type = 'N3.2'
      AND e.afterchange <> 1
      AND e.sabbaccountnumber = 'SASABB352703763001'
    GROUP BY 1, 2
),
LatestLoginTimestamp AS (
    SELECT 
        ee.clients_national_residency_commercial_id,
        MAX(ee.login_date) AS max_login_before
    FROM dp_vew_sem_risk_fraud.v_sama_login_extd_details_fraud ee
    INNER JOIN firstrestriction fr 
        ON ee.clients_national_residency_commercial_id = fr.id_number
    WHERE ee.login_date < fr.first_rest_time
      AND ee.clients_national_residency_commercial_id = 2512667243
    GROUP BY 1
)
SELECT ee.*, llt.max_login_before
FROM dp_vew_sem_risk_fraud.v_sama_login_extd_details_fraud ee
JOIN LatestLoginTimestamp llt 
    ON ee.clients_national_residency_commercial_id = llt.clients_national_residency_commercial_id
    AND ee.login_date = llt.max_login_before;

